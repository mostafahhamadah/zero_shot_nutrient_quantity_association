# ==============================================================================
# Zero-Shot Nutrient and Quantity Association — .gitignore
# Keep the repo to source + gold data. Everything generated, cached, heavy, or
# machine-local stays out.
# ==============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Secrets / credentials ─────────────────────────────────────────────────────
# The default VLM backend is a local LM Studio server (no key). The HF backend
# uses a token — never commit it.
.env
.env.*
*.key
*.pem
secrets.*
.hf_token
hf_token*
huggingface_token*

# ── Model weights & framework caches (large; auto-downloaded on first run) ─────
*.pt
*.pth
*.onnx
*.gguf
*.safetensors
*.bin
.cache/
.paddleocr/
.paddlex/
hf_cache/
*_cache/
/models/
/checkpoints/

# ── Experiment outputs (regenerated by the runners) ───────────────────────────
/outputs/
/runs/
/wandb/
*.log

# ── Data — track data/raw (input images) and test_set_normalized.csv.
#    Ignore only scratch / derived data. ───────────────────────────────────────
data/interim/
data/processed/
data/tmp/
data/**/*.zip
*.tmp

# ── LaTeX build artefacts (thesis) ────────────────────────────────────────────
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.toc
*.synctex.gz
*.run.xml
*.bcf
*.nav
*.snm
*.vrb
*.xdv
*-blx.bib
*.pdf

# ── IDE / editors ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS / OneDrive sync cruft ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*-DESKTOP-*.*
*.orig

# results tree — ignore everything except the two ablation folders
/results/*
!/results/ablation/
!/results/ablation_redo/

results/**/intermediate/
results/**/plots/
results/**/vlm_resized_images/

# stray/typo artifacts
thesis/thesis.t